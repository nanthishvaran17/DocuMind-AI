# =============================================================================
# DocuMind AI - Environment Configuration
# =============================================================================
# Never commit a populated .env file with real secrets.

# --- App & Environment ---
APP_NAME="DocuMind AI"
ENVIRONMENT="development"
DEBUG="true"
PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://documind.ai"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
CORS_ORIGINS="http://localhost:3000"

# --- Security & Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET_IN_PRODUCTION"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="15"
REFRESH_TOKEN_EXPIRE_DAYS="14"
GUEST_SESSION_EXPIRE_MINUTES="60"
CSRF_SECRET_KEY="CHANGE_ME_CSRF_SECRET"
COOKIE_SECURE="false"

# --- Google OAuth (optional in local dev) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# --- Database ---
# Docker / Production (PostgreSQL 16 + pgvector):
# DATABASE_URL="postgresql+asyncpg://documind:documind@localhost:5432/documind"
# Local Windows dev fallback (without Docker/Postgres):
DATABASE_URL="sqlite+aiosqlite:///./documind_dev.db"

# --- Redis & Celery ---
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
# "celery" (Redis/Docker) or "inline" (in-process dev runner when Redis is absent)
TASK_RUNNER="inline"

# --- Object Storage ---
# "s3" (MinIO / AWS S3) or "local" (local_storage folder for dev without Docker)
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./local_storage"
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="documind-uploads"
S3_REGION="us-east-1"

# --- Malware Scanning (ClamAV) ---
# "clamd" (Docker ClamAV daemon) or "disabled_dev" (explicitly skips AV in local dev without clamd)
CLAMAV_MODE="disabled_dev"
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"

# --- Limits & Quotas ---
MAX_UPLOAD_SIZE_MB="50"
MAX_PDF_PAGES="1000"
RATE_LIMIT_PER_MINUTE="120"

# --- AI Providers (Phase 4+, configured via env only) ---
AI_PROVIDER="openai_compatible"
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_CHAT_MODEL="gpt-4o-mini"
AI_EMBEDDING_MODEL="text-embedding-3-small"
OLLAMA_BASE_URL="http://localhost:11434"
ANTHROPIC_API_KEY=""

# --- Observability ---
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
LOG_LEVEL="INFO"
